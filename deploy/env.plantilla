# arrancar.sh crea /opt/neux/apps/subelo/.env a partir de esta plantilla la primera
# vez. SESSION_SECRET nace en el VPS (firma las sesiones): nunca pasa por GitHub ni
# por el chat. GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET llegan desde los secrets del
# repo con poner-claves.sh en cada despliegue (vacías = sin botón de Google).
# Entra hola@neuxmatrix.es; otra cuenta queda pendiente hasta que Fer la apruebe en
# la Torre (Sistema › Accesos), que contesta en TORRE_INTERNA por la red de Docker.
PORT=8080
NODE_ENV=production
TZ=Europe/Madrid
SESSION_SECRET={{SECRETO}}
# Vuelta de Google: $BASE_URL/api/auth/oauth/google/callback
BASE_URL=https://subelo.neuxmatrix.es
TORRE_INTERNA=http://torre:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
